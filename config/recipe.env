# recipe.env — MỌI tham số của pipeline nằm ở đây. Không hardcode số ở chỗ khác.
#   source config/recipe.env
# Sửa file này = sửa toàn bộ pipeline. Mỗi script chỉ đọc, không tự đặt mặc định.

# ─────────────────────────────────────────────────────────────────────────────
# 1. ĐƯỜNG DẪN — ba dòng duy nhất phải sửa ngày thi
# ─────────────────────────────────────────────────────────────────────────────
export VT_CODE="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"   # thư mục contest/ này

# MẶC ĐỊNH: mọi thứ sinh ra lúc chạy nằm trong contest/work/ — venv, trọng số pretrained,
# data, kết quả. Nhờ vậy clone repo về máy mới là đủ, và xoá work/ là sạch hoàn toàn.
# work/ nằm trong .gitignore nên không bao giờ bị commit.
export VT_ROOT="${VT_ROOT:-$VT_CODE/work}"
export VT_SCENE="${VT_SCENE:-$VT_ROOT/data/scene}" # scene BTC phát: train/{images,sparse/0} + test/test_poses.csv
export VT_VENV="${VT_VENV:-$VT_ROOT/venv}"        # môi trường python

# Trọng số pretrained (LPIPS-VGG, RAFT, SuperPoint/LightGlue) tải vào ĐÂY, không vào ~/.cache.
# torchvision/lightglue đều đọc biến này qua torch.hub.
export TORCH_HOME="${TORCH_HOME:-$VT_ROOT/models}"
export VT_SRC="$VT_CODE/src"
export VT_RUNS="$VT_ROOT/runs"
export VT_LOGS="$VT_ROOT/logs"
export VT_SCORES="$VT_ROOT/scores"
export VT_SUBMIT="$VT_ROOT/submit"
export PY="$VT_VENV/bin/python"
export PATH="$VT_VENV/bin:/usr/local/cuda/bin:$PATH"   # nvcc + ninja cho gsplat JIT

# Scene phái sinh do Giai đoạn 0 tạo ra (để trống nếu bỏ qua giai đoạn 0)
export VT_SCENE_FIXED_RAW="$VT_ROOT/data/scene_reSfM"       # SfM dựng lại, chưa chuyển pose test
export VT_SCENE_FIXED="$VT_ROOT/data/scene_reSfM_tr"        # + pose test đã chuyển  ← scene để train
# Scene thực sự dùng để train: bản đã sửa hình học nếu có, không thì scene gốc BTC.
# ⚠ TÍNH LẠI MỖI LẦN source — KHÔNG dùng ${VT_TRAIN_SCENE:-...} tự tham chiếu.
# Lý do: run_all.sh source file này TRƯỚC khi 10_geom.sh tạo ra scene đã sửa. Nếu tự
# tham chiếu, giá trị "scene gốc" bị đóng băng rồi export xuống mọi script con —
# giai đoạn 0 chạy xong vẫn bị vứt bỏ IM LẶNG, mất trọn đòn +3,9 điểm.
# Muốn ép tay thì đặt VT_TRAIN_SCENE_FORCE, đừng đặt VT_TRAIN_SCENE.
export VT_TRAIN_SCENE="${VT_TRAIN_SCENE_FORCE:-$([ -d "$VT_SCENE_FIXED" ] && echo "$VT_SCENE_FIXED" || echo "$VT_SCENE")}"

# GT test: BTC thường KHÔNG phát. Chỉ đặt khi thực sự có (vd. có tập dev có nhãn).
# Để trống = không chấm local được, phải dùng holdout. Xem docs/02_NGAY_1_DO_DAC.md.
export VT_GT_DIR="${VT_GT_DIR:-}"

# ─────────────────────────────────────────────────────────────────────────────
# 2. PHẦN CỨNG
# ─────────────────────────────────────────────────────────────────────────────
export VT_GPUS="${VT_GPUS:-0}"                 # card được phép dùng, vd "0,1,2,3"
export VT_VRAM_GB="${VT_VRAM_GB:-143}"         # VRAM mỗi card — quyết định CAP, xem §3
export VT_CPU_THREADS="${VT_CPU_THREADS:-32}"
# Dưới ngưỡng này thì watchdog hét vào log + thu hồi ckpt_mid.pt (xem disk_guard_start).
export VT_DISK_FLOOR_GB="${VT_DISK_FLOOR_GB:-60}"

# ─────────────────────────────────────────────────────────────────────────────
# 3. GIAI ĐOẠN 1 — 3DGS  (recipe đã chốt; mọi cờ đều có bằng chứng, xem docs/01)
# ─────────────────────────────────────────────────────────────────────────────
# CAP theo VRAM: 36M cần ~95 GB. Quy tắc an toàn ≈ 380k Gaussian / GB.
#   143 GB → 36M    80 GB → 24M    48 GB → 12M    24 GB → 6M
export VT_CAP="${VT_CAP:-36000000}"
export VT_STEPS="${VT_STEPS:-15000}"           # 15k = tối ưu; 30k ĐO ĐƯỢC LÀ HẠI (60,02 vs 60,38)
export VT_SEEDS="${VT_SEEDS:-42 7 11}"         # 3 seed cho band-swap; 1 seed nếu thiếu giờ

export VT_GS_FLAGS="\
--strategy mcmc \
--cap_max $VT_CAP \
--max_steps $VT_STEPS \
--batch_views 4 \
--lr_scale 2 \
--depth_weight 0.05 \
--wd_weight 0.10 \
--lpips_weight 0 \
--lpips_start $(( VT_STEPS / 2 )) \
--lpips_crop 512 \
--lpips_crops 8 \
--geo_consist_weight 0.5 \
--opacity_reg 0 \
--scale_reg 0.01 \
--antialiased 1 \
--sh_degree 3 \
--bilagrid 0 \
--test_use_train_K 1 \
--save_ckpt 1 \
--skip_test_render 1"

# ─────────────────────────────────────────────────────────────────────────────
# 4. GIAI ĐOẠN 2 — REFINER
# ─────────────────────────────────────────────────────────────────────────────
export VT_REF_CH="${VT_REF_CH:-48,96,192,384}"     # UNet 4 tầng, 4,38M tham số
export VT_REF_K="${VT_REF_K:-4}"                   # 07/09: K4 hơn K2 +0,74 điểm test (đo paired).
                                                   # K≥3 âm là kết luận trên nền hình học CŨ — đã lật.
export VT_REF_ITERS="${VT_REF_ITERS:-192000}"      # ~3,5 h. Thiếu giờ: 48000 (mất ~0,7đ)
export VT_REF_MAXVIEWS="${VT_REF_MAXVIEWS:-340}"
export VT_REF_WLPIPS="${VT_REF_WLPIPS:-0.6}"       # 0,4/0,8/0,9/1,0 đều thua
export VT_REF_SRCDROP="${VT_REF_SRCDROP:-0.3}"
export VT_REF_EVAL_EVERY="${VT_REF_EVAL_EVERY:-6000}"
# CÁCH SINH DỮ LIỆU DẠY REFINER — hai đường:
#   p2       (mặc định): bật --holdout_every 6 NGAY TRÊN 3 model seed. Model vừa làm nền
#            để nộp, vừa sinh cặp (render lỗi, ảnh thật) trên 1/6 view nó chưa thấy.
#            Rẻ hơn 7 GPU-giờ, và refiner học trên đầu ra model CÙNG CỠ với lúc triển khai.
#            Giá: model nền giấu 1/6 ảnh train ⇒ thô test −0,2 điểm (đo được).
#   separate: 4 model holdout riêng (đường đã sinh ra bản 62,0107). Đắt hơn nhưng model
#            nền thấy đủ 100% ảnh train.
export VT_REFDATA_MODE="${VT_REFDATA_MODE:-p2}"    # p2 | separate
export VT_HOLDOUT_EVERY="${VT_HOLDOUT_EVERY:-4}"   # chế độ separate: 4 model, mỗi model giấu 1/4
export VT_P2_EVERY="${VT_P2_EVERY:-6}"             # chế độ p2: mỗi seed giấu 1/6
export VT_P2_OFFSETS="${VT_P2_OFFSETS:-0 2 4}"     # residue cho từng seed, khớp thứ tự VT_SEEDS
# Giới hạn số view mỗi dump — chỉ để CHẠY THỬ luồng. Để trống = đủ view (dump ~20 GB/cái).
export VT_REFDATA_LIMIT="${VT_REFDATA_LIMIT:-}"

# --amp 1: bf16 autocast (loss vẫn fp32) → 18,7 it/s vs 11,7-12,2 = ×1,55, VAL y hệt.
export VT_REF_TRAIN_FLAGS="\
--amp 1 \
--ch $VT_REF_CH \
--extra 1 \
--K $VT_REF_K \
--iters $VT_REF_ITERS \
--bs 4 \
--crop 512 \
--lr 2e-4 \
--w_lpips $VT_REF_WLPIPS \
--src_drop $VT_REF_SRCDROP \
--max_views $VT_REF_MAXVIEWS \
--val_frac 0.15 \
--eval_every $VT_REF_EVAL_EVERY \
--gpu_data 1"

# Trọng số refiner dùng lúc suy luận.
# MẶC ĐỊNH: bản train trên CHÍNH data BTC vòng này (scripts/31_reftrain.sh sinh ra).
# ⚠ Trỏ sang trọng số train trên data vòng khác là VI PHẠM §11.1 — đọc docs/00_LUAT_THI.md.
export VT_REFINER="${VT_REFINER:-$VT_RUNS/refiner.pt}"

# ─────────────────────────────────────────────────────────────────────────────
# 5. GIAI ĐOẠN 0 — SỬA HÌNH HỌC (chỉ chạy khi cổng Sampson > 3 px)
# ─────────────────────────────────────────────────────────────────────────────
export VT_MATCH_RES="${VT_MATCH_RES:-3072}"
export VT_MATCH_KP="${VT_MATCH_KP:-8192}"
export VT_MATCH_MIN_OV="${VT_MATCH_MIN_OV:-0.15}"
export VT_SFM_CAM="${VT_SFM_CAM:-OPENCV}"          # cho phép méo — đây là cả đòn +3,9đ
export VT_MATCH_VRAM_GB="${VT_MATCH_VRAM_GB:-8}"  # VRAM tối thiểu mỗi tiến trình khớp dày
export VT_RANSAC="${VT_RANSAC:-usac}"              # USAC_DEFAULT: inlier 208 vs 128 của FM, lại còn nhanh hơn
# flash-SDPA của torch 2.13 tốn 0,4-0,8 s MỖI cỡ tensor mới; mỗi cặp ảnh có số keypoint
# khác nhau nên lần nào cũng "mới". Tắt = khớp 0,030 s/cặp thay vì 0,45. ĐỪNG bật lại.
export LG_FLASH="${LG_FLASH:-0}"
# GLOMAP (global_mapping có sẵn trong pycolmap 4.2) thay incremental: 25' thay 75', cùng nghiệm.
export VT_SFM_MODE="${VT_SFM_MODE:-glomap}"        # glomap | incremental
export VT_SAMPSON_GATE="${VT_SAMPSON_GATE:-3.0}"   # px. Dưới ngưỡng ⇒ BỎ QUA giai đoạn 0
# LightGlue thường cài NGOÀI venv ⇒ phải vào PYTHONPATH, nếu không match_dense.py chết.
export VT_LIGHTGLUE="${VT_LIGHTGLUE:-$VT_ROOT/lg_pkgs}"   # nguồn LightGlue (không có trên pip)

# ─────────────────────────────────────────────────────────────────────────────
# 6. GIAI ĐOẠN 3 — HẬU XỬ LÝ
# ─────────────────────────────────────────────────────────────────────────────
export VT_BANDSWAP_SIGMA="${VT_BANDSWAP_SIGMA:-8}"   # σ=8 > σ=4 (61,26 vs ~61,24)

export TOKENIZERS_PARALLELISM=false
export WANDB_MODE=offline
mkdir -p "$VT_RUNS" "$VT_LOGS" "$VT_SCORES" "$VT_SUBMIT" "$TORCH_HOME"
